# ---------------------------------------------------------------------------
# Marg backend — example environment file.
#
# HOW TO USE THIS FILE
#   1. Copy it:            cp .env.example .env
#   2. Fill in ONE api key (or leave AI_PROVIDER=mock to run with no key at all)
#   3. Change JWT_SECRET to any long random string
#   4. Run:                npm run dev
#
# Every variable below is read and validated in src/config/env.js. If something
# required is missing, the server refuses to start and tells you exactly which
# variable to fix — it will not crash later with a confusing error.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------

# Port the API listens on.
PORT=4000

# "development" | "production" | "test".
# In development, error responses include a stack trace to help you debug.
NODE_ENV=development

# Which websites are allowed to call this API from a browser (CORS).
# Comma-separated. Use "*" to allow everything (fine locally, bad in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# --- Auth -------------------------------------------------------------------

# Secret used to sign guest login tokens. MUST be changed before deploying.
# Generate a good one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me-to-a-long-random-string

# How long a guest token stays valid. Accepts "30d", "12h", "45m", etc.
JWT_TTL=30d


# --- AI provider ------------------------------------------------------------

# Which AI service to use. One of:
#   gemini             Google Gemini (needs GEMINI_API_KEY)
#   openrouter         OpenRouter    (needs OPENROUTER_API_KEY)
#   openai-compatible  Any OpenAI-style endpoint: Groq, Together, Ollama, vLLM…
#   mock               No network calls, canned answers. Great for frontend work.
AI_PROVIDER=mock

# Optional. If the main provider fails (rate limit, outage), Marg automatically
# retries with this one. Leave blank to disable fallback.
AI_FALLBACK_PROVIDER=

# Google Gemini — get a free key at https://aistudio.google.com/apikey
# gemini-2.5-flash is retired for new accounts (Google 404s it with a pointer
# to a newer model). gemini-3.5-flash-lite is confirmed working on a fresh key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Any other OpenAI-compatible service (used when AI_PROVIDER=openai-compatible).
# Examples:
#   Groq    -> https://api.groq.com/openai/v1
#   Ollama  -> http://localhost:11434/v1   (OPENAI_COMPATIBLE_API_KEY can be "ollama")
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Marg makes two kinds of AI calls:
#   - fast, tiny calls   (working out what the student wants, safety checks)
#   - main teaching calls (explaining, marking, hints)
# Setting a cheaper small model here noticeably reduces your bill.
# Leave blank to use the same model for both.
AI_MODEL_FAST=

# Give up on a single AI request after this many milliseconds.
AI_TIMEOUT_MS=60000


# --- Storage ----------------------------------------------------------------

# Where data lives. Right now only "memory" is implemented.
# NOTE: "memory" means everything is lost when the server restarts. That is
# intentional for now — see docs/ARCHITECTURE.md for the Turso migration path.
STORE_DRIVER=memory


# --- Tutoring behaviour -----------------------------------------------------

# true  = Marg only helps with study/academic work and refuses to do a student's
#         assignment for them (it still teaches them how to do it).
# false = the guardrails are relaxed. See docs/TUTORING-MODEL.md.
STRICT_SCOPE=true

# When Marg is willing to hand over the final answer:
#   on_request    first ask gives a hint, asking again reveals the answer
#   after_attempt the student must try the step before the answer unlocks
#   never         hints only, never the final answer
DEFAULT_ANSWER_POLICY=on_request


# --- Rate limiting ----------------------------------------------------------

# Max AI-powered requests per user per minute (these cost money).
RATE_LIMIT_AI_PER_MIN=20

# Max ordinary requests per user per minute (listing sessions, etc.).
RATE_LIMIT_GENERAL_PER_MIN=120

# Largest photo the /vision endpoints will accept, in megabytes.
MAX_UPLOAD_MB=8
